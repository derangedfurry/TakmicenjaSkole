@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PrezentacioniSloj</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PrezentacioniSloj.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">


                @Html.ActionLink("Rezultati srednjoškolskih takmičenja", "Index", "Pocetna", new { area = "" }, new { @class = "navbar-brand" })

                <a class="navbar-brand" asp-area="" asp-controller="Pocetna" asp-action="Index"></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li>
							<a class="nav-link text-dark" asp-area="" asp-controller="Takmicenje" asp-action="Rezultati">Rezultati takmicenja</a>
                        </li>
                        @if(Context.Session.GetString("KorisnikId") != null)
                        {
                            <li>
                                <a class="nav-link text-dark" asp-area="" asp-controller="Takmicenje" asp-action="DodajRezultat">Dodaj takmicenje</a>
                            </li>
						}
                    </ul>

                    <ul class="navbar-nav flex-grow-1">
                @if (Context.Session.GetString("KorisnikUloga") == "Admin" ) ///test
                {
                        <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Diploma" asp-action="Index">Diploma</a>
                        </li>
                        <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Takmicenje" asp-action="Index">Takmicenje</a>
						</li>
                        <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Korisnik" asp-action="Index">Korisnik</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Predmet" asp-action="Index">Predmet</a>
                        </li>
                        <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Ucenik" asp-action="Index">Ucenik</a>
                        </li>
                }
                    </ul>

                    <ul class="navbar-nav">
                        @if (Context.Session.GetInt32("KorisnikId") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Korisnik" asp-action="Odjava">Odjavi se</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Korisnik" asp-action="Prijava">Prijavi se</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Korisnik" asp-action="Registracija">Registracija</a>
                            </li>
						}
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PrezentacioniSloj - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
