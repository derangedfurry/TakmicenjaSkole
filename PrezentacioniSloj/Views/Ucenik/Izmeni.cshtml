@model PrezentacioniSloj.ViewModel.UcenikViewModel

@{
    ViewData["Title"] = "Izmeni";
}

<h1>Izmeni</h1>
<h4>Učenik</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Izmeni" method="post" id="ucenikIzmenaForma" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="ID" id="ucenikIdSakriven" />

            <div class="form-group mb-3">
                <label asp-for="ID" class="control-label"></label>
                <input asp-for="ID" class="form-control" disabled />
                <span asp-validation-for="ID" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SifraUcenika" class="control-label"></label>
                <input asp-for="SifraUcenika"
                       class="form-control"
                       maxlength="5"
                       minlength="5"
                       required 
                       value="@Model.SifraUcenika"
                       />
                <span asp-validation-for="SifraUcenika" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Ime" class="control-label"></label>
                <input asp-for="Ime" class="form-control" required value="@Model.Ime"/>
                <span asp-validation-for="Ime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Prezime" class="control-label"></label>
                <input asp-for="Prezime" class="form-control" required value="@Model.Prezime"/>
                <span asp-validation-for="Prezime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BrojBodova" class="control-label"></label>
                <input asp-for="BrojBodova"
                       class="form-control"
                       type="number"
                       min="0"
                       max="100"
                       required 
                       value="@Model.BrojBodova"
                       />
                <span asp-validation-for="BrojBodova" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IDTakmicenja" class="control-label"></label>
                <input asp-for="IDTakmicenja" class="form-control" required hidden value="@Model.IDTakmicenja"/>
                <span asp-validation-for="IDTakmicenja" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Sačuvaj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Nazad do liste</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ucenik-izmena-validacija.js" asp-append-version="true"></script>
}