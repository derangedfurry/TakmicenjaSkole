@model PrezentacioniSloj.ViewModel.PredmetViewModel

@{
    ViewData["Title"] = "Obriši";
}

<h1>Obriši</h1>

<h3>Da li ste sigurni da želite da obrišete ovaj predmet?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ID)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ID)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NazivPredmeta)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NazivPredmeta)
        </dd>
    </dl>
    
    <form asp-action="Obrisi" asp-route-id="@Model.ID">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Obrisi" class="btn btn-danger" /> |
        <a asp-action="Index">Nazad do liste predmeta</a>
    </form>
</div>
