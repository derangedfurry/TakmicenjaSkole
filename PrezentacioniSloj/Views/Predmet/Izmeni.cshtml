@model PrezentacioniSloj.ViewModel.PredmetViewModel

@{
    ViewData["Title"] = "Izmeni";
}

<h1>Izmeni</h1>
<h4>Predmet</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Izmeni" asp-route-id="@Model.ID" method="post" id="predmetEditForm" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* Hidden field so ID is posted (disabled inputs are not submitted) *@
            <input type="hidden" asp-for="ID" />

            <div class="form-group mb-3">
                <label asp-for="ID" class="control-label"></label>
                <input asp-for="ID" class="form-control" disabled />
                <span asp-validation-for="ID" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NazivPredmeta" class="control-label"></label>
                <input asp-for="NazivPredmeta"
                       class="form-control"
                       required />
                <span asp-validation-for="NazivPredmeta" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Sačuvaj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Nazad do liste predmeta</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/predmet-izmena-validacija.js" asp-append-version="true"></script>
}