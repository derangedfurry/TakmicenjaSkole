@model PrezentacioniSloj.ViewModel.DodajTakmicenjeViewModel
@{
    ViewData["Title"] = "Dodaj";
}

<h1>Dodaj Rezultat Takmičenja</h1>

<form asp-action="DodajRezultat" method="post" id="masterDetailForm" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- ==================== MASTER ==================== -->
    <div class="card mb-4">
        <div class="card-header">Podaci o takmičenju</div>
        <div class="card-body">
            <div class="row">


                <div class="col-md-6 mb-3">
                    <label asp-for="Takmicenje.NazivTakmicenja" class="form-label"></label>
                    <input asp-for="Takmicenje.NazivTakmicenja" class="form-control" required />
                    <span asp-validation-for="Takmicenje.NazivTakmicenja" class="text-danger"></span>
                    <input asp-for="Takmicenje.KorisnikID" value="@Context.Session.GetInt32("KorisnikId")" hidden/>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Takmicenje.DatumTakmicenja" class="form-label"></label>
                    <input asp-for="Takmicenje.DatumTakmicenja"
                           class="form-control"
                           type="datetime-local"
                           required value="@DateTime.Now" />
                    <span asp-validation-for="Takmicenje.DatumTakmicenja" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Takmicenje.NazivPredmetaTakmicenja" class="form-label">Predmet</label>
                    <select asp-for="Takmicenje.NazivPredmetaTakmicenja" class="form-select" required
                            asp-items="@(new SelectList(Model.Predmet, "NazivPredmeta", "NazivPredmeta"))">
                        <option value="">-- Izaberite predmet --</option>
                    </select>
                    <span asp-validation-for="Takmicenje.NazivPredmetaTakmicenja" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Takmicenje.LokacijaTakmicenja" class="form-label">Lokacija takmičenja</label>
                    <input asp-for="Takmicenje.LokacijaTakmicenja" class="form-control" required />
                    <span asp-validation-for="Takmicenje.LokacijaTakmicenja" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Takmicenje.TipTakmicenja" class="form-label">Tip takmičenja</label>
                    <select asp-for="Takmicenje.TipTakmicenja" class="form-select" required>
                        <option value="">-- Izaberite tip --</option>
                        <option value="Školski nivo">Školski nivo</option>
                        <option value="Opštinski nivo">Opštinski nivo</option>
                        <option value="Okružni nivo">Okružni nivo</option>
                        <option value="Republički nivo">Republički nivo</option>
                        <option value="Međunarodni nivo">Međunarodni nivo</option>
                    </select>
                    <span asp-validation-for="Takmicenje.TipTakmicenja" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== DETAIL ==================== -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Učenici</span>
            <button type="button" class="btn btn-success btn-sm" id="DodajUcenikaDugme">
                + Dodaj učenika
            </button>
        </div>
        <div class="card-body">
            <table class="table table-bordered" id="uceniciTable">
                <thead>
                    <tr>
                        <th>Šifra</th>
                        <th>Ime</th>
                        <th>Prezime</th>
                        <th>Broj bodova</th>
                        <th style="width:50px;"></th>
                    </tr>
                </thead>
                <tbody id="uceniciBody">
                    @for (int i = 0; i < Model.Ucenik.Count; i++)
                    {
                        <tr class="ucenik-row">
                            <td>
                                <input asp-for="Ucenik[i].SifraUcenika" class="form-control"
                                       maxlength="5" minlength="5" required />
                            </td>
                            <td>
                                <input asp-for="Ucenik[i].Ime" class="form-control" required />
                            </td>
                            <td>
                                <input asp-for="Ucenik[i].Prezime" class="form-control" required />
                            </td>
                            <td>
                                <input asp-for="Ucenik[i].BrojBodova" class="form-control"
                                       type="number" min="0" required />
                            </td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm btn-remove">X</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Sačuvaj sve</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/takmicenje-validacija.js" asp-append-version="true"></script>
    <script>
        let ucenikIndex = @Model.Ucenik.Count;

        document.getElementById('DodajUcenikaDugme').addEventListener('click', function () {
            const tbody = document.getElementById('uceniciBody');
            const noviRed = `
                <tr class="ucenik-row">
                    <td>
                        <input class="form-control" name="Ucenik[${ucenikIndex}].SifraUcenika"
                               maxlength="5" minlength="5" required />
                    </td>
                    <td>
                        <input class="form-control" name="Ucenik[${ucenikIndex}].Ime" required />
                    </td>
                    <td>
                        <input class="form-control" name="Ucenik[${ucenikIndex}].Prezime" required />
                    </td>
                    <td>
                        <input class="form-control" name="Ucenik[${ucenikIndex}].BrojBodova"
                               type="number" min="0" value="0" required />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm btn-remove">X</button>
                    </td>
                </tr>`;
            tbody.insertAdjacentHTML('beforeend', noviRed);
            ucenikIndex++;
        });

        document.getElementById('uceniciBody').addEventListener('click', function (e) {
            if (e.target.classList.contains('btn-remove')) {
                e.target.closest('tr').remove();
                reindex();
            }
        });

        function reindex() {
            const rows = document.querySelectorAll('#uceniciBody tr');
            rows.forEach((row, index) => {
                row.querySelectorAll('input').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name) {
                        input.setAttribute('name', name.replace(/Ucenik\[\d+\]/, `Ucenik[${index}]`));
                    }
                });
            });
            ucenikIndex = rows.length;
        }
    </script>
}