@model PrezentacioniSloj.ViewModel.DiplomaViewModel
@{
    Layout = null;
    ViewData["Title"] = "Diploma";


    bool jePohvalnica =
        Model.Nagrada == 4 ||
        (Model.NazivNagrade?.Contains("Pohvalnica", StringComparison.OrdinalIgnoreCase) ?? false);

    string naslov = jePohvalnica ? "POHVALNICA" : "DIPLOMA";
    string cssClass = jePohvalnica ? "pohvalnica" : "diploma";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@naslov – @Model.ImeUcenika @Model.PrezimeUcenika</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: Georgia, serif;
            text-align: center;
            padding: 40px;
            background: #f5f5f5;
        }

        .certificate {
            border: 6px double #333;
            padding: 50px 40px;
            max-width: 800px;
            margin: 0 auto;
        }


        .diploma {
            background-color: #e3f2fd; 
            border-color: #1565c0;
        }

 
        .pohvalnica {
            background-color: #fff9c4; 
            border-color: #f9a825;
        }

        .certificate h1 {
            font-size: 2.2rem;
            letter-spacing: 4px;
            margin-bottom: 30px;
        }

        .diploma h1 {
            color: #0d47a1;
        }

        .pohvalnica h1 {
            color: #f57f17;
        }

        .certificate .name {
            font-size: 1.8rem;
            font-weight: bold;
            margin: 25px 0;
        }

        .certificate .award {
            font-size: 1.4rem;
            margin: 20px 0;
            color: #333;
        }

        .no-print {
            margin-bottom: 20px;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                padding: 0;
                background: #fff;
            }

            .diploma {
                background-color: #e3f2fd !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .pohvalnica {
                background-color: #fff9c4 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button class="btn btn-primary" onclick="window.print()">Štampaj</button>
        <button class="btn btn-secondary" onclick="window.close()">Zatvori</button>
    </div>

    @{
        if (naslov == "POHVALNICA")
        {
            <div class="certificate @cssClass">
                <h1>@naslov</h1>
                <p>Ovim se potvrđuje da je učenik učestvovao na takmičenju</p>
                <div class="name">
                    @Model.ImeUcenika @Model.PrezimeUcenika
                </div>
                <p>@(jePohvalnica ? "dobio/la" : "osvojio/la")</p>
                <div class="award">
                    @Model.NazivNagrade
                </div>
            </div>
        } else
        {
            <div class="certificate @cssClass">
                <h1>@naslov</h1>
                <p>Ovim se potvrđuje da je učenik</p>
                <div class="name">
                    @Model.ImeUcenika @Model.PrezimeUcenika
                </div>
                <p>@(jePohvalnica ? "dobio/la" : "osvojio/la")</p>
                <div class="award">
                    @Model.NazivNagrade
                </div>
                <p class="mt-4 text-muted">
                    Nagrada br. @Model.Nagrada
                </p>
            </div>
        }
    }

</body>
</html>