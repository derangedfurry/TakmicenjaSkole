@model PrezentacioniSloj.ViewModel.DiplomaViewModel

@{
    ViewData["Title"] = "Obrisi";
}

<h1>Obrisi</h1>

<h3>Da li ste sigurni da želite da obrišete ovu diplomu?</h3>
<div>
    <h4>DiplomaViewModel</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ID)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ID)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nagrada)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nagrada)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NazivNagrade)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NazivNagrade)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ImeUcenika)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ImeUcenika)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PrezimeUcenika)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PrezimeUcenika)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IDUcenika)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IDUcenika)
        </dd>
    </dl>
    
    <form asp-action="Obrisi" asp-route-id="@Model.ID">
        <input type="submit" value="Obrisi" class="btn btn-danger" /> |
        <a asp-action="Index">Nazad do liste</a>
    </form>
</div>
