@model IEnumerable<PrezentacioniSloj.ViewModel.DiplomaViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Dodaj">Dodaj novu diplomu</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nagrada)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NazivNagrade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImeUcenika)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrezimeUcenika)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IDUcenika)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nagrada)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NazivNagrade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ImeUcenika)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PrezimeUcenika)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IDUcenika)
            </td>
            <td>
                    @Html.ActionLink("Izmeni", "Izmeni", new { id = item.ID }) |
                    @Html.ActionLink("Detalji", "Detalji", new { id = item.ID }) |
                    @Html.ActionLink("Obrisi", "Obrisi", new {  id=item.ID })
            </td>
        </tr>
}
    </tbody>
</table>
